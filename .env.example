# Copy to .env and fill in. NEVER commit .env.

# Required: your Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-...

# Required: where your Obsidian vault lives on disk (absolute path).
VAULT_PATH=/Users/you/Documents/MyVault

# Required: the vault name as Obsidian sees it (used by the obsidian CLI).
VAULT_NAME=MyVault

# Optional: where Hermes stores its skills/state outside the vault.
# HERMES_HOME=~/.hermes

# Optional model overrides (defaults shown).
# CLAUDE_CHEAP_MODEL=claude-haiku-4-5-20251001
# CLAUDE_FAST_MODEL=claude-sonnet-4-20250514
# CLAUDE_DEEP_MODEL=claude-opus-4-0-20250115
