<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.hermes.vault-watcher</string>
    <key>ProgramArguments</key>
    <array>
        <string>__HERMES_HOME__/scripts/vault-watcher.sh</string>
    </array>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__HERMES_HOME__/logs/watcher.log</string>
    <key>StandardErrorPath</key>
    <string>__HERMES_HOME__/logs/watcher.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
        <key>HERMES_HOME</key>
        <string>__HERMES_HOME__</string>
        <key>VAULT_PATH</key>
        <string>__VAULT_PATH__</string>
        <key>VAULT_NAME</key>
        <string>__VAULT_NAME__</string>
    </dict>
</dict>
</plist>
